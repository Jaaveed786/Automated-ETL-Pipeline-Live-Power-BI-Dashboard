# Environment Variables Configuration
# Copy this file to .env for local development

# Database Connection (SQLite default for local dev, PostgreSQL for cloud)
# SQLite example: sqlite:///data/warehouse.db
# PostgreSQL example: postgresql+psycopg2://user:password@ep-cool-cloud.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///data/warehouse.db

# Slack / Discord Webhook URL for ETL failure alerts (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
