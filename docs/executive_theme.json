{
  "name": "Executive Dark Luxury",
  "dataColors": [
    "#38BDF8",
    "#818CF8",
    "#34D399",
    "#FBBF24",
    "#F472B6",
    "#A78BFA",
    "#FB923C",
    "#4ADE80"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#38BDF8",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Bold",
            "color": { "solid": { "color": "#38BDF8" } }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": { "solid": { "color": "#94A3B8" } }
          }
        ]
      }
    }
  }
}
